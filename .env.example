# =============================================================
# Polylop Configuration
# =============================================================
# Fork of MiroFish-Offline. Unlike upstream, this fork does NOT run the
# LLM locally: reasoning goes to Mistral Cloud (EU/France), embeddings stay
# local on the host's Ollama. Copy this file to .env and fill in your key.
#
# Do not claim "100% offline" anywhere - see POLYLOP.md.
# =============================================================

# ===== LLM Configuration (Mistral Cloud, OpenAI-compatible) =====
LLM_API_KEY=your-mistral-key-here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL_NAME=mistral-small-2506
# Polylop tier: lighter/faster model for persona generation (step 2)
LLM_MODEL_NAME_FAST=mistral-small-latest

# ===== Neo4j Configuration =====
# Service name "neo4j" - the backend runs inside the same compose network
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration (stays local) =====
# Ollama runs on the Docker HOST, not in a container - hence
# host.docker.internal. Pull the model once: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://host.docker.internal:11434
# EMBEDDING_API_KEY falls back to LLM_API_KEY if unset

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY / OPENAI_API_BASE_URL - point them at the
# same Mistral endpoint as above.
OPENAI_API_KEY=your-mistral-key-here
OPENAI_API_BASE_URL=https://api.mistral.ai/v1

# ===== Optional: separate tier for graph extraction (upstream PR #41) =====
# High-volume entity extraction can run on a cheaper model. Falls back to
# the primary LLM_* values when unset.
# GRAPH_LLM_API_KEY=
# GRAPH_LLM_BASE_URL=https://api.mistral.ai/v1
# GRAPH_LLM_MODEL_NAME=mistral-small-latest

# ===== Optional: fully local variant (upstream default) =====
# Not used by Polylop - local models were judged uneconomical on the
# available hardware. Kept here so the upstream path stays documented:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL_NAME=qwen2.5:32b
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE_URL=http://host.docker.internal:11434/v1
